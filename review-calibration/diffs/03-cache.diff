new file mode 100644
--- /dev/null
+++ b/internal/cache/cache.go
@@ -0,0 +1,26 @@
+package cache
+
+import "time"
+
+type Cache struct {
+	items map[string]entry
+}
+
+type entry struct {
+	val     []byte
+	expires time.Time
+}
+
+func New() *Cache { return &Cache{items: map[string]entry{}} }
+
+func (c *Cache) Get(k string) ([]byte, bool) {
+	e, ok := c.items[k]
+	if !ok {
+		return nil, false
+	}
+	return e.val, true
+}
+
+func (c *Cache) Set(k string, v []byte, ttl time.Duration) {
+	c.items[k] = entry{val: v, expires: time.Now().Add(ttl)}
+}
