+package api
+
+import (
+	"testing"
+	"time"
+)
+
+var counter int
+
+func TestSlug(t *testing.T) {
+	cases := []struct {
+		in, want string
+	}{
+		{"Hello World", "hello-world"},
+		{"", ""},
+	}
+	for _, c := range cases {
+		got := slug(c.in)
+		if got != c.want {
+			t.Fatal("wrong slug")
+		}
+	}
+}
+
+func TestAsync(t *testing.T) {
+	counter = 0
+	go func() { counter++ }()
+	time.Sleep(100 * time.Millisecond)
+	if counter != 1 {
+		t.Error("not incremented")
+	}
+}
