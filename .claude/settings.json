{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/services/**)",
      "Edit(/cmd/**)",
      "Edit(/internal/**)",
      "Edit(/pkg/**)",
      "Edit(/docs/rfcs/**)",
      "Edit(/docs/postmortems/**)",
      "Edit(/learner/brag-doc.md)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_start.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_owned_paths.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
